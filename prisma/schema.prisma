generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  HOME_DECOR
  DESK_ACCESSORIES
  LAMPS
  VASES_AND_PLANTERS
  TOYS_AND_FIDGETS
  COLLECTIBLES_AND_FIGURES
  GAMING_AND_POP_CULTURE
  COSPLAY_PROPS_AND_MODEL_KITS
  CUSTOM_AND_PERSONALIZED
  PET_ACCESSORIES
}

enum SizeMode {
  FIXED
  OPTIONS
}

enum ColorMode {
  FIXED
  OPTIONS
}

enum AdminRole {
  SUPER
  ADMIN
}

model Product {
  id               String   @id @default(cuid())
  name             String
  description      String
  price            Float
  images           String[]
  category         Category
  subcategory      String?
  color            String
  colorMode        ColorMode @default(FIXED)
  colorOptions     String[]  @default([])
  size             String
  sizeMode         SizeMode @default(FIXED)
  sizeOptions      Json?
  discountPercent  Int      @default(0)
  customizable     Boolean  @default(false)
  inStock          Boolean  @default(true)
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([category])
  @@index([featured, inStock])
  @@index([inStock, updatedAt])
  @@index([createdAt])
  @@index([price])

  @@map("products")
}

model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  username  String    @unique
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())

  @@map("admins")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

model ShippingRate {
  id       String         @id @default(cuid())
  method   ShippingMethod @unique
  label    String
  price    Float
  isActive Boolean        @default(true)

  @@map("shipping_rates")
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  shippingMethod ShippingMethod
  shippingCost   Float
  subtotal       Float
  total          Float
  paymentMethod  String         @default("COD")
  status         OrderStatus    @default(PENDING)
  notes          String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  productImage String?
  selectedSize String?
  color        String?
  quantity     Int
  unitPrice    Float
  totalPrice   Float

  @@map("order_items")
}
