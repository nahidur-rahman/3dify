# ===========================================
# 3Dify BD — Environment Variables
# ===========================================

# Database (Supabase PostgreSQL connection string)
# DATABASE_URL uses the Supabase pooler for runtime queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL is used by Prisma migrations.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Storage (server-side image upload/delete)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
ADMIN_TOKEN_VALIDITY="3d"

# Admin Seed Credentials
ADMIN_EMAIL="admin@3difybd.com"
ADMIN_PASSWORD="changeme123"

# Order emails (server-side only; never prefix the API key with NEXT_PUBLIC_)
RESEND_API_KEY="your-resend-api-key"
ORDER_EMAIL_FROM="3DifyBD Orders <orders@mail.3difybd.com>"
# Notification recipient; independent of the admin login/seed email above.
ORDER_ADMIN_EMAIL="3difybd@gmail.com"
# Customer replies go here. If empty, defaults to ORDER_ADMIN_EMAIL.
ORDER_EMAIL_REPLY_TO="3difybd@gmail.com"

# Contact Links (public — exposed to browser)
NEXT_PUBLIC_WHATSAPP="+8801XXXXXXXXX"
NEXT_PUBLIC_MESSENGER="https://www.messenger.com/t/your-page-or-profile-id/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/your-page"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/your-handle/"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="3Dify BD"

# Optional product image cap. Leave empty for unlimited uploads.
PRODUCT_IMAGE_LIMIT="8"

# Seed behavior
SEED_SAMPLE_PRODUCTS="true"
